# Clean URLs: serve pages without the .html extension.
# Assumes the site lives at the domain root (e.g. https://27thmarketing.com/).

Options -MultiViews -Indexes
DirectoryIndex home.html index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# /home and /home.html -> / (home.html is the landing page)
RewriteCond %{THE_REQUEST} \s/+home(?:\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /page.html -> /page
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /page -> serve page.html internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Make sure reels and posters are served with the right types
AddType video/mp4 .mp4
AddType image/jpeg .jpg .jpeg
